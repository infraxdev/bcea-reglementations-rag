# fastembed model cache (app/ingestion/embed.py, app/retrieval/rerank.py) -- without
# this, fastembed caches to tempfile.gettempdir()/fastembed_cache, which gets wiped on
# reboot (or every container restart), forcing a re-download from HuggingFace/GCS on the
# next query. Point it at a persistent directory.
FASTEMBED_CACHE_PATH=.cache/fastembed

# Local disk storage
LOCAL_STORAGE_BASE_DIR=data

# S3 / S3-compatible storage (only needed if you'll use storage_backend="s3")
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PREFIX=
S3_USE_SSL=true

# Qdrant (vector store used by ingestion + retrieval)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=bceao_regulations

# Generation LLM (app/generation/llm.py) -- provider is one of: ollama | openai | anthropic
# GENERATION_MODEL overrides the provider's default (qwen2.5:7b / gpt-5 / claude-opus-5).
GENERATION_PROVIDER=ollama
GENERATION_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Standalone query rewriter LLM (app/retrieval/rewrite.py) -- only used when the scope
# router below didn't already supply the rewritten query (its failure path). Separate
# from GENERATION_PROVIDER above since it favors a fast local model. Same provider values; reuses OLLAMA_BASE_URL/OPENAI_API_KEY/
# ANTHROPIC_API_KEY from above.
REWRITE_PROVIDER=ollama
REWRITE_MODEL=

# Scope-router LLM (app/retrieval/router.py's LLMScopeRouter) -- called once on every
# message to decide whether it is in scope, small talk, or off topic, and in the same
# call write the rewritten search query (in scope) or the reply shown to the user
# (small talk / off topic). Same provider values;
# reuses OLLAMA_BASE_URL/OPENAI_API_KEY/ANTHROPIC_API_KEY from above.
ROUTER_PROVIDER=ollama
ROUTER_MODEL=

# CORS (app/main.py) -- comma-separated origins allowed to call this API from a browser.
# Defaults to the Next.js dev server (web/); add your deployed frontend's origin here too.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Jobs (app/config.py:get_job_settings) -- how POST /crawl and POST /ingest/{job_id} run.
# Defaults run jobs inside the API process with in-memory state: fine for `uvicorn` alone.
# compose.yml overrides these to use ElasticMQ (SQS) + DynamoDB Local + `app.worker`, and
# the EKS ConfigMaps set them for real SQS/DynamoDB/S3. See README "Jobs".
# (Comments stay on their own lines: Docker Compose's env_file parser keeps inline ones.)
#
# Queue: inprocess | sqs
JOB_QUEUE_BACKEND=inprocess
# Job state: memory | dynamodb (dynamodb is required with sqs)
JOB_STATE_BACKEND=memory
# Crawl manifests: local (job_metadata/) | s3 (S3_BUCKET/job_metadata/)
JOB_MANIFEST_BACKEND=local
# Default storage_backend for crawl requests: local | s3
CRAWL_STORAGE_BACKEND=local
# Only with JOB_QUEUE_BACKEND=sqs / JOB_STATE_BACKEND=dynamodb. Leave the endpoint URLs
# empty on AWS; set them for ElasticMQ / DynamoDB Local.
CRAWL_JOBS_QUEUE_URL=
INGEST_JOBS_QUEUE_URL=
SQS_ENDPOINT_URL=
JOBS_TABLE_NAME=bceao-rag-local-jobs
JOB_PROGRESS_TABLE_NAME=bceao-rag-local-job-progress
DYNAMODB_ENDPOINT_URL=
# Create the tables if missing (local only; Terraform creates them on AWS)
JOB_STATE_CREATE_TABLES=false
# Tuning. JOB_MAX_ATTEMPTS must equal the queue's maxReceiveCount. A queued/running job
# silent for JOB_STALE_SECONDS is considered dead. Retry backoff is multiplied by the
# attempt number.
JOB_MAX_ATTEMPTS=3
JOB_STALE_SECONDS=600
JOB_HEARTBEAT_SECONDS=60
JOB_VISIBILITY_TIMEOUT_SECONDS=900
JOB_RETRY_BACKOFF_SECONDS=60
